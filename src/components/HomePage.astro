---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ui, localePrefixes, localeLangTags, type Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].home;
const prefix = localePrefixes[locale];
const canonicalUrl = `https://rubenspessoa.dev${prefix}/`;

const alternates = [
  { hreflang: 'en-GB', href: 'https://rubenspessoa.dev/' },
  { hreflang: 'pt-BR', href: 'https://rubenspessoa.dev/pt-br/' },
  { hreflang: 'de-AT', href: 'https://rubenspessoa.dev/de/' },
  { hreflang: 'x-default', href: 'https://rubenspessoa.dev/' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': 'https://rubenspessoa.dev/#person',
      name: 'Rubens Pessoa',
      url: 'https://rubenspessoa.dev/',
      image: 'https://rubenspessoa.dev/images/1753387860689.jpeg',
      jobTitle: 'Founder',
      description: 'Independent founder building apps for iPhone, iPad, and Mac.',
      email: 'mailto:contact@rubenspessoa.dev',
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalUrl,
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Graz',
        addressCountry: 'AT',
      },
      sameAs: [
        'https://github.com/rubenspessoa',
        'https://www.linkedin.com/in/rubenspbf/',
        'https://x.com/rubenspbf',
        'https://www.threads.net/@rubenspbf',
        'https://www.instagram.com/rubenspbf/',
        'https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4',
        'https://www.hustlrr.ai/',
        'https://savemycactus.rubenspessoa.dev/',
        'https://nitpickr.rubenspessoa.dev/',
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://rubenspessoa.dev/#pixeldog',
      name: 'Pixeldog',
      description: 'One-person app studio of Rubens Pessoa.',
      url: 'https://rubenspessoa.dev/',
      logo: 'https://rubenspessoa.dev/images/brand/pixeldog-icon.png',
      founder: { '@id': 'https://rubenspessoa.dev/#person' },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Graz',
        addressCountry: 'AT',
      },
    },
    {
      '@type': 'WebSite',
      '@id': 'https://rubenspessoa.dev/#website',
      url: 'https://rubenspessoa.dev/',
      name: 'Pixeldog',
      inLanguage: localeLangTags[locale],
      description: t.ogDescription,
      publisher: {
        '@id': 'https://rubenspessoa.dev/#pixeldog',
      },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Save My Cactus',
      operatingSystem: 'iOS',
      applicationCategory: 'LifestyleApplication',
      description: t.smc.jsonDescription,
      url: 'https://savemycactus.rubenspessoa.dev/',
      image: 'https://rubenspessoa.dev/images/apps/save-my-cactus-icon.png',
      author: { '@id': 'https://rubenspessoa.dev/#person' },
      publisher: { '@id': 'https://rubenspessoa.dev/#pixeldog' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Hustlrr',
      operatingSystem: 'iOS, iPadOS, macOS',
      applicationCategory: 'ProductivityApplication',
      description: t.hustlrr.jsonDescription,
      url: 'https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223',
      image: 'https://rubenspessoa.dev/images/apps/hustlrr-icon.jpg',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@id': 'https://rubenspessoa.dev/#person' },
      publisher: { '@id': 'https://rubenspessoa.dev/#pixeldog' },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Giorni',
      operatingSystem: 'iOS',
      applicationCategory: 'ProductivityApplication',
      description: t.giorni.jsonDescription,
      url: 'https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435',
      image: 'https://rubenspessoa.dev/images/apps/giorni-icon.jpg',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      author: { '@id': 'https://rubenspessoa.dev/#person' },
      publisher: { '@id': 'https://rubenspessoa.dev/#pixeldog' },
    },
  ],
};
---

<BaseLayout
  title={t.title}
  description={t.description}
  canonicalUrl={canonicalUrl}
  ogTitle={t.title}
  ogDescription={t.ogDescription}
  jsonLd={jsonLd}
  locale={locale}
  alternates={alternates}
>
  <section class="hero">
    <h1>{t.heroTitle}</h1>
    <p class="hero__lede">{t.heroLede}</p>
  </section>

  <section id="apps" class="section">
    <h2>{t.appsLabel}</h2>

    <div class="app-list">
      <article class="app">
        <div class="app__head">
          <img
            class="app__icon"
            src="/images/apps/save-my-cactus-icon.png"
            alt=""
            width="128"
            height="128"
            loading="eager"
            decoding="async"
          />
          <div class="app__title">
            <h3>Save My Cactus</h3>
            <p class="app__tagline">{t.smc.tagline}</p>
          </div>
        </div>

        <p class="app__summary">{t.smc.summary}</p>

        <div class="app__actions">
          <span class="badge">{t.comingSoon}</span>
          <a
            class="text-link"
            href="https://savemycactus.rubenspessoa.dev/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>{t.learnMore}</span>
            <svg class="link-icon" viewBox="0 0 20 20" aria-hidden="true">
              <use href="#icon-arrow-up-right"></use>
            </svg>
          </a>
        </div>
      </article>

      <article class="app">
        <div class="app__head">
          <img
            class="app__icon"
            src="/images/apps/hustlrr-icon.jpg"
            alt=""
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
          <div class="app__title">
            <h3>Hustlrr</h3>
            <p class="app__tagline">{t.hustlrr.tagline}</p>
          </div>
        </div>

        <p class="app__summary">{t.hustlrr.summary}</p>

        <div class="app__actions">
          <a
            class="app-store-link"
            href="https://apps.apple.com/us/app/hustlrr-question-ai-chat/id6737912223?uo=4"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.hustlrr.storeAria}
          >
            <img
              src="/images/apps/app-store-badge.svg"
              alt="Download on the App Store"
              width="120"
              height="40"
              loading="lazy"
              decoding="async"
            />
          </a>
          <a
            class="text-link"
            href="https://www.hustlrr.ai/"
            target="_blank"
            rel="noopener noreferrer"
          >
            <span>hustlrr.ai</span>
            <svg class="link-icon" viewBox="0 0 20 20" aria-hidden="true">
              <use href="#icon-arrow-up-right"></use>
            </svg>
          </a>
        </div>
      </article>

      <article class="app">
        <div class="app__head">
          <img
            class="app__icon"
            src="/images/apps/giorni-icon.jpg"
            alt=""
            width="128"
            height="128"
            loading="lazy"
            decoding="async"
          />
          <div class="app__title">
            <h3>Giorni</h3>
            <p class="app__tagline">{t.giorni.tagline}</p>
          </div>
        </div>

        <p class="app__summary">{t.giorni.summary}</p>

        <div class="app__actions">
          <a
            class="app-store-link"
            href="https://apps.apple.com/us/app/daily-habit-tracker-giorni/id6505112435?uo=4"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t.giorni.storeAria}
          >
            <img
              src="/images/apps/app-store-badge.svg"
              alt="Download on the App Store"
              width="120"
              height="40"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </article>
    </div>
  </section>

  <section class="section">
    <p class="provenance">
      <span class="provenance__flag" role="img" aria-label={t.provenanceFlagAlt}>
        🇪🇺
      </span>
      {t.provenance}
    </p>
  </section>
</BaseLayout>
