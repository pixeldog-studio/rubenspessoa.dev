---
import { ui, localeNames, localePrefixes, pathForLocale, type Locale } from '../i18n/ui';
import PixeldogMark from './PixeldogMark.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const currentPath = Astro.url.pathname;
const locales = Object.keys(localeNames) as Locale[];
const prefix = localePrefixes[locale];
const home = prefix ? `${prefix}/` : '/';
---

<footer class="site-footer">
  <div class="footer-row">
    <a class="footer-brand" href={home} aria-label="Pixeldog">
      <PixeldogMark class="footer-brand__logo" />
    </a>

    <div class="footer-links" aria-label="Footer links">
      <a
        class="footer-link"
        href="mailto:contact@rubenspessoa.dev"
        aria-label="contact@rubenspessoa.dev"
        title="contact@rubenspessoa.dev"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect
            x="2.85"
            y="4.85"
            width="18.3"
            height="14.3"
            rx="2.6"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
          ></rect>
          <path
            d="M3.4 7.4 12 13.4l8.6-6"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
          ></path>
        </svg>
      </a>
      <a
        class="footer-link"
        href="https://www.linkedin.com/in/rubenspbf/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        title="LinkedIn"
      >
        <svg viewBox="0 0 17.5 17.5" aria-hidden="true">
          <use href="#icon-linkedin"></use>
        </svg>
      </a>
      <a
        class="footer-link"
        href="https://github.com/rubenspessoa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        title="GitHub"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M9.5 18c-3 1-3-1.5-4.5-2"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
          ></path>
          <path
            d="M14.5 18v-2.6c0-.7.1-1.2-.3-1.7 2.3-.3 4.8-1.1 4.8-5.1 0-1.1-.4-2.1-1-2.8.1-.3.5-1.4-.1-2.8 0 0-.8-.3-2.9 1.1a10.2 10.2 0 0 0-5.4 0C7.5 3 6.7 3.3 6.7 3.3c-.6 1.4-.2 2.5-.1 2.8-.7.7-1 1.7-1 2.8 0 4 2.4 4.8 4.8 5.1-.4.5-.4 1.1-.4 1.7V18"
            fill="none"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
          ></path>
        </svg>
      </a>
      <a
        class="footer-link"
        href="https://x.com/rubenspbf"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="X"
        title="X"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"
            fill="currentColor"
          ></path>
        </svg>
      </a>
      <a
        class="footer-link"
        href="https://www.threads.net/@rubenspbf"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Threads"
        title="Threads"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12.186 24h-.007c-3.581-.024-6.334-1.205-8.184-3.509C2.35 18.44 1.5 15.586 1.472 12.01v-.017c.03-3.579.879-6.43 2.525-8.482C5.845 1.205 8.6.024 12.18 0h.014c2.746.02 5.043.725 6.826 2.098 1.677 1.29 2.858 3.13 3.509 5.467l-2.04.569c-1.104-3.96-3.898-5.984-8.304-6.015-2.91.022-5.11.936-6.54 2.717C4.307 6.504 3.616 8.914 3.589 12c.027 3.086.718 5.496 2.057 7.164 1.43 1.783 3.631 2.698 6.54 2.717 2.623-.02 4.358-.631 5.8-2.045 1.647-1.613 1.618-3.593 1.09-4.798-.31-.71-.873-1.3-1.634-1.75-.192 1.352-.622 2.446-1.284 3.272-.886 1.102-2.14 1.704-3.73 1.79-1.202.065-2.361-.218-3.259-.801-1.063-.689-1.685-1.74-1.752-2.964-.065-1.19.408-2.285 1.33-3.082.88-.76 2.119-1.207 3.583-1.291a13.853 13.853 0 0 1 3.02.142c-.126-.742-.375-1.332-.75-1.757-.513-.586-1.308-.883-2.359-.89h-.029c-.844 0-1.992.232-2.721 1.32L7.734 7.847c.98-1.454 2.568-2.256 4.478-2.256h.044c3.194.02 5.097 1.975 5.287 5.388.108.046.216.094.321.142 1.49.7 2.58 1.761 3.154 3.07.797 1.82.871 4.79-1.548 7.158-1.85 1.81-4.094 2.628-7.277 2.65Zm1.003-11.69c-.242 0-.487.007-.739.021-1.836.103-2.98.946-2.916 2.143.067 1.256 1.452 1.839 2.784 1.767 1.224-.065 2.818-.543 3.086-3.71a10.5 10.5 0 0 0-2.215-.221z"
            fill="currentColor"
          ></path>
        </svg>
      </a>
      <a
        class="footer-link"
        href="https://www.instagram.com/rubenspbf/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        title="Instagram"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <rect
            x="3.2"
            y="3.2"
            width="17.6"
            height="17.6"
            rx="5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
          ></rect>
          <circle
            cx="12"
            cy="12"
            r="4"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
          ></circle>
          <circle cx="17.15" cy="6.85" r="1.15" fill="currentColor"></circle>
        </svg>
      </a>
      <a
        class="footer-link"
        href="https://apps.apple.com/us/developer/rubens-pessoa-de-barros-filho/id1703452695?uo=4"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="App Store"
        title="App Store"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"
            fill="currentColor"
          ></path>
        </svg>
      </a>
    </div>
  </div>

  <div class="footer-row">
    <div class="footer-links">
      <a href="/privacy/">{t.footer.privacy}</a>
      <a href="/terms/">{t.footer.terms}</a>
      <a href="/imprint/">{t.footer.imprint}</a>
      <span>{t.footer.builtIn}</span>
    </div>

    <div class="footer-links footer-controls">
      <details class="lang-menu" id="lang-menu">
        <summary aria-label={t.footer.language} title={t.footer.language}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle
              cx="12"
              cy="12"
              r="8.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></circle>
            <ellipse
              cx="12"
              cy="12"
              rx="3.6"
              ry="8.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></ellipse>
            <path
              d="M4 9.2h16M4 14.8h16"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></path>
          </svg>
          <span>{localeNames[locale]}</span>
          <svg class="lang-menu__chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="m6 9 6 6 6-6"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.2"
            ></path>
          </svg>
        </summary>
        <ul class="lang-menu__list">
          {locales.map((l) => (
            <li>
              <a
                href={pathForLocale(currentPath, l)}
                aria-current={l === locale ? 'true' : undefined}
                lang={l === 'pt-br' ? 'pt-BR' : l}
              >
                {localeNames[l]}
              </a>
            </li>
          ))}
        </ul>
      </details>

      <div class="theme-group" id="theme-group" role="radiogroup" aria-label={t.footer.themeName}>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-value="auto"
          aria-label={t.footer.themeLabels.auto}
          title={t.footer.themeLabels.auto}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle
              cx="12"
              cy="12"
              r="8.5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></circle>
            <path d="M12 3.5a8.5 8.5 0 0 1 0 17Z" fill="currentColor"></path>
          </svg>
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-value="light"
          aria-label={t.footer.themeLabels.light}
          title={t.footer.themeLabels.light}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle
              cx="12"
              cy="12"
              r="3.8"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
            ></circle>
            <path
              d="M12 2.8v2.2M12 19v2.2M2.8 12h2.2M19 12h2.2M5.5 5.5l1.55 1.55M16.95 16.95l1.55 1.55M18.5 5.5l-1.55 1.55M7.05 16.95L5.5 18.5"
              fill="none"
              stroke="currentColor"
              stroke-linecap="round"
              stroke-width="1.7"
            ></path>
          </svg>
        </button>
        <button
          type="button"
          role="radio"
          aria-checked="false"
          data-theme-value="dark"
          aria-label={t.footer.themeLabels.dark}
          title={t.footer.themeLabels.dark}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              d="M20.4 13.2A8.5 8.5 0 1 1 10.8 3.6a6.8 6.8 0 0 0 9.6 9.6Z"
              fill="none"
              stroke="currentColor"
              stroke-linejoin="round"
              stroke-width="1.7"
            ></path>
          </svg>
        </button>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const group = document.getElementById('theme-group');
    if (group) {
      const buttons = Array.from(group.querySelectorAll('button'));
      const current = () => {
        try {
          const v = localStorage.getItem('theme');
          return v === 'light' || v === 'dark' ? v : 'auto';
        } catch {
          return 'auto';
        }
      };
      const apply = (v) => {
        if (v === 'auto') delete root.dataset.theme;
        else root.dataset.theme = v;
        buttons.forEach((b) => b.setAttribute('aria-checked', String(b.dataset.themeValue === v)));
      };
      apply(current());
      buttons.forEach((b) =>
        b.addEventListener('click', () => {
          const v = b.dataset.themeValue;
          try {
            if (v === 'auto') localStorage.removeItem('theme');
            else localStorage.setItem('theme', v);
          } catch {}
          apply(v);
        }),
      );
    }

    const menu = document.getElementById('lang-menu');
    if (menu) {
      document.addEventListener('click', (e) => {
        if (menu.open && !menu.contains(e.target)) menu.open = false;
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') menu.open = false;
      });
    }
  })();
</script>
