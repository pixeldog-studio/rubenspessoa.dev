---
import { ui, localePrefixes, type Locale } from '../i18n/ui';
import PixeldogLogo from './PixeldogLogo.astro';

interface Props {
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const prefix = localePrefixes[locale];
const home = prefix ? `${prefix}/` : '/';
const currentPath = Astro.url.pathname;
const aboutPath = `${prefix}/about/`;
---

<header class="site-header">
  <a class="brand" href={home}>
    <PixeldogLogo />
  </a>

  <nav class="site-nav" aria-label="Primary">
    <a href={`${home}#apps`}>{t.nav.apps}</a>
    <a href={aboutPath} aria-current={currentPath.startsWith(aboutPath) ? 'page' : undefined}>
      {t.nav.about}
    </a>
  </nav>
</header>
