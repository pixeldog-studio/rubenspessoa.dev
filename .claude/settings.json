{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm dev)",
      "Bash(pnpm check)",
      "Bash(pnpm build)",
      "Bash(pnpm verify)",
      "Bash(pnpm preview)",
      "Bash(pnpm astro check)",
      "Bash(node scripts/verify-dist.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git worktree:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr list:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(linear issue view:*)",
      "Bash(linear issue list:*)",
      "Bash(brain search:*)",
      "Bash(brain brief:*)"
    ],
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/*.p8)",
      "Read(./**/.sentryclirc)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin develop:*)",
      "Bash(git push origin master:*)",
      "Bash(linear auth token:*)"
    ]
  },
  "env": {
    "HQ_FAST_VERIFY": "pnpm check"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Developer/hq/hooks/worktree-guard.mjs\"; [ -f \"$f\" ] || { echo \"[hq] guard missing: $f (clone ~/Developer/hq on develop)\" >&2; exit 2; }; (cd \"$HOME/Developer/hq\" && node \"$f\") || { echo \"[hq] guard failed to run or denied: worktree-guard\" >&2; exit 2; }"
          },
          {
            "type": "command",
            "command": "f=\"$HOME/Developer/hq/hooks/config-protection.mjs\"; [ -f \"$f\" ] || { echo \"[hq] guard missing: $f (clone ~/Developer/hq on develop)\" >&2; exit 2; }; (cd \"$HOME/Developer/hq\" && node \"$f\") || { echo \"[hq] guard failed to run or denied: config-protection\" >&2; exit 2; }"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$HOME/Developer/hq/hooks/git-guard.mjs\"; [ -f \"$f\" ] || { echo \"[hq] guard missing: $f (clone ~/Developer/hq on develop)\" >&2; exit 2; }; (cd \"$HOME/Developer/hq\" && node \"$f\") || { echo \"[hq] guard failed to run or denied: git-guard\" >&2; exit 2; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Developer/hq/hooks/lint-on-edit.mjs\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/Developer/hq/hooks/stop-verify.mjs\"",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
