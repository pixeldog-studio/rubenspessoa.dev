"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":635.75},{"type":"text","id":"t19b","name":"Our apps are informational and productiv","content":"Our apps are informational and productivity tools — with clear limits:","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":673.16},{"type":"text","id":"t19c","name":"Content generated by AI — identification","content":"Content generated by AI — identifications, diagnoses, answers, suggestions, and similar — can be wrong, incomplete, or outdated. It is informational only and is not medical, legal, financial, or other professional advice; verify important information before acting on it.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":746.85},{"type":"text","id":"t19d","name":"Never rely solely on app results for dec","content":"Never rely solely on app results for decisions affecting the health or safety of people or animals. If a person or animal may have ingested something harmful, contact a doctor, veterinarian, or poison control immediately.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":1004.87},{"type":"text","id":"t19e","name":"Third-party data shown in the Services —","content":"Third-party data shown in the Services — such as retail prices drawn from public data sources — is informational only and can be outdated or wrong; the terms and prices of the respective third party apply. We are not affiliated with the third parties whose data appears in the Services.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":1206.79},{"type":"text","id":"t19f","name":"None of our apps is a medical device or ","content":"None of our apps is a medical device or a therapeutic product.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":1464.8},{"type":"text","id":"t19g","name":"Acceptable use","content":"Acceptable use","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":1556.44},{"type":"text","id":"t19h","name":"You may use the Services only within the","content":"You may use the Services only within the scope of what they are provided for, under these terms and applicable law. You agree not to:","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":1593.85},{"type":"text","id":"t19i","name":"access our API endpoints other than thro","content":"access our API endpoints other than through the apps, or attempt to circumvent usage limits, subscription checks, or app verification","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":1723.63},{"type":"text","id":"t19j","name":"use automated tools to scrape, bulk-down","content":"use automated tools to scrape, bulk-download, or resell our content, data, or AI results","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":2