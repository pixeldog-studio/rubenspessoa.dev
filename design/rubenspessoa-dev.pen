nk-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":4797.05},{"type":"text","id":"tym","name":"How long data is kept","content":"How long data is kept","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":5056.97},{"type":"text","id":"tyn","name":"Personal data is processed and stored on","content":"Personal data is processed and stored only as long as required by the purpose it was collected for: content submitted to AI features is not retained on our servers at all; rate-limit and usage counters expire automatically within days; analytics, attribution, and crash data follow the retention settings of the respective tool. Once the retention period expires, data is deleted.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":5094.38},{"type":"text","id":"tyo","name":"Your rights","content":"Your rights","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":5438.44},{"type":"text","id":"typ","name":"Depending on where you live, you have th","content":"Depending on where you live, you have the right to access, rectify, delete, restrict, or receive a copy of your data, to object to processing based on legitimate interest, and to withdraw consent at any time (for tracking and location, directly in iOS Settings).","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":5475.85},{"type":"text","id":"tyq","name":"EU/EEA and 