tSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":350.5,"x":0,"y":5724.23}]},{"type":"ref","id":"rwm","ref":"f6a","name":"footer / mobile","x":20,"y":6077.8}]}]}],"x":19780,"y":0},{"type":"ref","id":"D1z1","ref":"Pwk","name":"GH-29/A/privacy/mobile/dark","x":20250,"y":0,"theme":{"mode":"dark"}},{"type":"frame","id":"P117","name":"GH-29/A/privacy/narrow/light","reusable":true,"theme":{"mode":"light"},"width":320,"height":7620,"clip":true,"layout":"none","fill":"$bg","children":[{"type":"frame","id":"f116","name":"body","x":0,"y":0,"width":320,"height":7620.16,"fill":["$bg",{"type":"gradient","gradientType":"radial","colors":[{"color":"$literal-0EB8B812","position":0},{"color":"$literal-00000000","position":0.62}]}],"layout":"none","children":[{"type":"frame","id":"f115","name":"div.page-shell","x":0,"y":0,"width":320,"height":7620.16,"layout":"vertical","padding":[0,0,0,"$spacing-20"],"children":[{"type":"ref","id":"r118","ref":"f6m","name":"header / narrow","x":20,"y":0},{"type":"frame","id":"fzs","name":"main","x":20,"y":95.67,"width":280,"height":7160.09,"layout":"none","children":[{"type":"text","id":"twu","name":"LEGAL","content":"LEGAL","fill":"$ink-muted","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-12_8","fontWeight":"$fontWeight-590","lineHeight":"$lineHeight-1_65","letterSpacing":"$letterSpacing-1_28","x":12.78,"y":55.94},{"type":"text","id":"twv","name":"Privacy Policy","content":"Privacy Policy","fill":"$ink","fontFamily":"$font-sf-pro-30","fontSize":"$fontSize-30_4","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_67","x":0,"y":88.37},{"type":"text","id":"tww","name":"Effective date: July 23, 2026","content":"Effective date: July 23, 2026","fill":"$ink-muted","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-15_2","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":137.05},{"type":"text","id":"twx","name":"This policy covers all apps published by","content":"This policy covers all apps published by Rubens Pessoa de Barros Filho, BSc, operating under the business name “Pixeldog” (“we”), their websites, and this website. It explains what data is processed, why, who processes it, and the rights you have. It is written to apply to every app we publish, so depending on which app you use, only a subset of it applies.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":194.65},{"type":"text","id":"twy","name":"The short version: our apps are designed","content":"The short version: our apps are designed to work without accounts, your content stays on your device (and in your own iCloud, if you use it), payments run through Apple, and we do not sell your personal data.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":520.76},{"type":"text","id":"twz","name":"Who is responsible","content":"Who is responsible","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":724.58},{"type":"text","id":"tx0","name":"Rubens Pessoa de Barros Filho,","content":"Rubens Pessoa de Barros Filho,","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":761.99},{"type":"text","id":"tx1","name":"BSc (Pixeldog)","content":"BSc (Pixeldog)","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":790.04},{"type":"text","id":"tx2","name":"UNESCO-Esplanade 8/55, 8020","content":"UNESCO-Esplanade 8/55, 8020","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":818.08},{"type":"text","id":"tx3","name":"Graz, Austria","content":"Graz, Austria","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":846.13},{"type":"text","id":"tx4","name":"Email:","content":"Email:","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":874.18},{"type":"text","id":"tx5","name":"contact@rubenspessoa.dev","content":"contact@rubenspessoa.dev","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","underline":true,"x":49.61,"y":874.18},{"type":"text","id":"tx6","name":"See the","content":"See the","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":919.82},{"type":"text","id":"tx7","name":"imprint","content":"imprint","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","underline":true,"x":62.27,"y":919.82},{"type":"text","id":"tx8","name":"for full legal details.","content":"for full legal details.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":119.73,"y":919.82},{"type":"text","id":"tx9","name":"What we process","content":"What we process","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":983.41},{"type":"text","id":"txa","name":"What is processed depends on the feature","content":"What is processed depends on the features of the app you use. Across our apps, processing falls into these categories:","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":1020.82},{"type":"text","id":"txb","name":"AI features","content":"AI features","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":1160.95},{"type":"text","id":"txc","name":"In apps with AI features, the content yo","content":"In apps with AI features, the content you submit for processing — photos, text, uploaded documents, or text transcribed from voice input — is sent through our servers to third-party AI providers, solely to generate the result. This content carries no account identifier, is not used to train AI models under our API agreements, and is not stored on our servers: it is processed in memory and discarded.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":1189.16},{"type":"text","id":"txd","name":"Your content","content":"Your content","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":1553.67},{"type":"text","id":"txe","name":"The content you create in our apps — sav","content":"The content you create in our apps — saved photos, chat history, habits, notes, and similar — is stored on your device and, if you use iCloud, synced through your own private iCloud storage. We run no accounts and keep no copy on our servers.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":1581.88},{"type":"text","id":"txf","name":"Anonymous identifiers","content":"Anonymous identifiers","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":1806.15},{"type":"text","id":"txg","name":"Apps that talk to our servers create an ","content":"Apps that talk to our servers create an anonymous identifier via Firebase to enforce fair usage limits and connect a subscription to your installation, and may verify requests with Firebase App Check to keep bots away. We cannot identify you personally from these identifiers.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":1834.37},{"type":"text","id":"txh","name":"Location","content":"Location","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":2086.69},{"type":"text","id":"txi","name":"In apps with location-based features, an","content":"In apps with location-based features, and only with your permission, your device location is used at query time to show nearby results. It is not stored as a movement history.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":2114.9},{"type":"text","id":"txj","name":"Ads and attribution","content":"Ads and attribution","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":2311.12},{"type":"text","id":"txk","name":"In apps with a free ad-supported tier, a","content":"In apps with a free ad-supported tier, ads are served by Google AdMob: if you allow tracking in the iOS App Tracking Transparency prompt, ads may be personalized; if you decline, they are not. Attribution services (such as AppsFlyer or Adjust) process device identifiers to attribute app installs to marketing campaigns, subject to the same tracking choice.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":2339.33},{"type":"text","id":"txl","name":"Analytics and crash reporting","content":"Analytics and crash reporting","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":2675.8},{"type":"text","id":"txm","name":"Our apps may collect analytics events ab","content":"Our apps may collect analytics events about feature usage — not the content you create — and crash reports (device model, OS version, crash traces) to keep the apps working well.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":2704.01},{"type":"text","id":"txn","name":"This website and app websites","content":"This website and app websites","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-16_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_25","x":0,"y":2900.23},{"type":"text","id":"txo","name":"This website (rubenspessoa.dev) is stati","content":"This website (rubenspessoa.dev) is static and sets no cookies and runs no analytics. Some app websites use analytics and, where required, ask for cookie consent; their processing is covered by the services listed below.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":2928.44},{"type":"text","id":"txp","name":"Third-party services","content":"Third-party services","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":3160.32},{"type":"text","id":"txq","name":"We keep the list of processors as small ","content":"We keep the list of processors as small as each app allows. Not every service is used by every app — which subset applies depends on the app’s features. Contact us for app-specific details:","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":280.5,"x":0,"y":3197.73},{"type":"text","id":"txr","name":"Apple (USA): App Store distribution, pay","content":"Apple (USA): App Store distribution, payments, device services, iCloud","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3383.6},{"type":"text","id":"txs","name":"Google Firebase (USA/Ireland): server in","content":"Google Firebase (USA/Ireland): server infrastructure (Cloud Functions), app verification (App Check), analytics (Google Analytics for Firebase), and crash reporting (Crashlytics)","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3473.33},{"type":"text","id":"txt","name":"RevenueCat (USA): subscription status, k","content":"RevenueCat (USA): subscription status, keyed to anonymous identifiers","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3647.21},{"type":"text","id":"txu","name":"OpenAI (USA) and Anthropic (USA): genera","content":"OpenAI (USA) and Anthropic (USA): generating AI responses","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3736.94},{"type":"text","id":"txv","name":"Other specialized AI service providers (","content":"Other specialized AI service providers (USA): AI analysis of submitted photos","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3798.63},{"type":"text","id":"txw","name":"PostHog (EU-hosted): product analytics","content":"PostHog (EU-hosted): product analytics","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3888.37},{"type":"text","id":"txx","name":"TelemetryDeck (Germany): anonymized prod","content":"TelemetryDeck (Germany): anonymized product analytics","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":3950.05},{"type":"text","id":"txy","name":"Amplitude (USA): product analytics","content":"Amplitude (USA): product analytics","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":4011.74},{"type":"text","id":"txz","name":"Sentry (USA): crash and error reporting","content":"Sentry (USA): crash and error reporting","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":4073.43},{"type":"text","id":"ty0","name":"Google AdMob (USA): advertising in free ","content":"Google AdMob (USA): advertising in free ad-supported tiers","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":4135.12},{"type":"text","id":"ty1","name":"AppsFlyer (USA/EU) and Adjust (Germany):","content":"AppsFlyer (USA/EU) and Adjust (Germany): install attribution","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":260.5,"x":20,"y":4196.8},{"type":"text","id":"ty2","name":"Algolia (USA): search features","content":"Algolia (USA): search features","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":20,"y":4258.49},{"type":"text","id":"ty3","name":"Legal bases","content":"Legal bases","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":4322.08},{"type":"text","id":"ty4","name":"Under the GDPR (and the","content":"Under the GDPR (and the","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":4359.49},{"type":"text","id":"ty5","name":"corresponding bases of the Brazilian","content":"corresponding bases of the Brazilian","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":0,"y":4387.54},{"type":"text","id":"ty6","name":"LGPD) we process data based on:","content":"LGPD) we process data based on:","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontW