ht-400","lineHeight":"$lineHeight-1_65","x":80,"y":148.57},{"type":"text","id":"toa","name":"This policy covers all apps published by","content":"This policy covers all apps published by Rubens Pessoa de Barros Filho, BSc, operating under the business name “Pixeldog” (“we”), their websites, and this website. It explains what data is processed, why, who processes it, and the rights you have. It is written to apply to every app we publish, so depending on which app you use, only a subset of it applies.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":672.5,"x":80,"y":206.16},{"type":"text","id":"tob","name":"The short version: our apps are designed","content":"The short version: our apps are designed to work without accounts, your content stays on your device (and in your own iCloud, if you use it), payments run through Apple, and we do not sell your personal data.","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":672.5,"x":80,"y":363.99},{"type":"text","id":"toc","name":"Who is responsible","content":"Who is responsible","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":80,"y":483.68},{"type":"text","id":"tod","name":"Rubens Pessoa de Barros Filho, BSc (Pixe","content":"Rubens Pessoa de Barros Filho, BSc (Pixeldog)","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":80,"y":521.08},{"type":"text","id":"toe","name":"UNESCO-Esplanade 8/55, 8020 Graz, Austri","content":"UNESCO-Esplanade 8/55, 8020 Graz, Austria","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWei