"lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":350.5,"x":0,"y":4281.02},{"type":"text","id":"tu6","name":"Your rights","content":"Your rights","fill":"$ink","fontFamily":"$font-sf-pro-21","fontSize":"$fontSize-20_8","fontWeight":"$fontWeight-650","lineHeight":"$lineHeight-1_2","letterSpacing":"$letterSpacing--0_31","x":0,"y":4568.99},{"type":"text","id":"tu7","name":"Depending on where you live, you have th","content":"Depending on where you live, you have the right to access, rectify, delete, restrict, or receive a copy of your data, to object to processing based on legitimate interest, and to withdraw consent at any time (for tracking and location, directly in iOS Settings).","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","textGrowth":"fixed-width","width":350.5,"x":0,"y":4606.4},{"type":"text","id":"tu8","name":"EU/EEA and Switzerland:","content":"EU/EEA and Switzerland:","fill":"$ink","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-700","lineHeight":"$lineHeight-1_65","x":20,"y":4792.27},{"type":"text","id":"tu9","name":"the rights above","content":"the rights above","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":224.83,"y":4792.27},{"type":"text","id":"tua","name":"under the GDPR and Swiss FADP, and the","content":"under the GDPR and Swiss FADP, and the","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":20,"y":4820.32},{"type":"text","id":"tub","name":"right to complain to the Austrian Data","content":"right to complain to the Austrian Data","fill":"$ink-soft","fontFamily":"$font-sf-pro-17","fontSize":"$fontSize-17","fontWeight":"$fontWeight-400","lineHeight":"$lineHeight-1_65","x":20,"y":4848.37},{"type":"text","id":"tuc","name":"